<?xml version="1.0" encoding="utf-8"?>
<!-- Flex Window（Z Flip 外屏）小组件布局（RemoteViews 子集：LinearLayout/TextView/ImageView/Button 只用允许的属性）。
     目标尺寸 339x352dp（Samsung 官方推荐的 Flex Window 整屏组件），同时兼容主屏 4x2 摆放。
     颜色全部取 ds_* token（values-night 自动跟随深色）；文案由 CoverWidgetProvider.render 运行时写入。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/cover_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:background="@drawable/cover_widget_bg"
  android:padding="14dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <ImageView
      android:id="@+id/cover_dot"
      android:layout_width="12dp"
      android:layout_height="12dp"
      android:layout_marginEnd="8dp"
      android:src="@drawable/cover_dot"
      android:contentDescription="@string/cover_status_dot" />

    <TextView
      android:id="@+id/cover_title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:textSize="16sp"
      android:textStyle="bold"
      android:textColor="@color/ds_text_primary"
      android:maxLines="1"
      android:ellipsize="end"
      android:text="@string/cover_state_unknown" />

    <TextView
      android:id="@+id/cover_version"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textSize="11sp"
      android:textColor="@color/ds_text_tertiary"
      android:background="@drawable/cover_widget_chip"
      android:paddingStart="8dp"
      android:paddingEnd="8dp"
      android:paddingTop="3dp"
      android:paddingBottom="3dp"
      android:text="@string/cover_version_placeholder" />
  </LinearLayout>

  <TextView
    android:id="@+id/cover_detail"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:textSize="12sp"
    android:textColor="@color/ds_text_secondary"
    android:maxLines="2"
    android:ellipsize="end"
    android:text="@string/cover_detail_placeholder" />

  <TextView
    android:id="@+id/cover_keepalive"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:textSize="11sp"
    android:textColor="@color/ds_text_tertiary"
    android:maxLines="1"
    android:ellipsize="end"
    android:text="@string/cover_detail_placeholder" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="horizontal" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:orientation="horizontal">

    <Button
      android:id="@+id/cover_btn_toggle"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:layout_marginEnd="6dp"
      android:background="@drawable/cover_widget_btn_primary"
      android:textColor="@color/ds_text_on_accent"
      android:textSize="14sp"
      android:textAllCaps="false"
      android:text="@string/cover_action_start" />

    <Button
      android:id="@+id/cover_btn_restart"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:background="@drawable/cover_widget_btn"
      android:textColor="@color/ds_text_primary"
      android:textSize="14sp"
      android:textAllCaps="false"
      android:text="@string/cover_action_restart" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:layout_marginTop="6dp"
    android:orientation="horizontal">

    <Button
      android:id="@+id/cover_btn_panel"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:layout_marginEnd="6dp"
      android:background="@drawable/cover_widget_btn"
      android:textColor="@color/ds_text_primary"
      android:textSize="14sp"
      android:textAllCaps="false"
      android:text="@string/cover_action_panel" />

    <Button
      android:id="@+id/cover_btn_full"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:background="@drawable/cover_widget_btn"
      android:textColor="@color/ds_text_primary"
      android:textSize="14sp"
      android:textAllCaps="false"
      android:text="@string/cover_action_full_ui" />
  </LinearLayout>
</LinearLayout>
